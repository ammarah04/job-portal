{
  "ConnectionStrings": {
    "DefaultConnection": "Server=host.docker.internal\\SQLEXPRESS;Database=JobPortalDB;User Id=your_username;Password=your_password;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "ReplaceThisWithYourOwn32CharacterSecretKey!",
    "Issuer": "JobPortalAPI",
    "Audience": "JobPortalClient",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "FileStorage": {
    "BasePath": "Uploads"
  },
  "PythonService": {
    "BaseUrl": "http://python-service:8000"
  }
}